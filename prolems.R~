library(junco)
library(pharmaverseadamjnj)

lyt <- basic_table() |>
    split_cols_by("TRT01P") |>
    split_rows_by("AEBODSYS", split_fun = trim_levels_in_group("AEDECOD")) |>
    split_rows_by("AEDECOD") |>
    split_rows_by("RACE") |>
    analyze("AETOXGR")

system.time({tbl <- build_table(lyt, adae, alt_counts_df = adsl)})


do_one <- function(naebodsys, dat = adae) {
    newdat <- dat[dat$AEBODSYS %in% levels(dat$AEBODSYS)[seq(1, naebodsys)],]
    newdat$AEBODSYS <- factor(newdat$AEBODSYS)
    lyt <- basic_table() |>
        split_cols_by("TRT01P") |>
        split_rows_by("AEBODSYS", split_fun = trim_levels_in_group("AEDECOD")) |>
        split_rows_by("AEDECOD") |>
        split_rows_by("RACE") |>
        analyze("AETOXGR")
    gc()
    bldtime <- system.time({tbl <- build_table(lyt, newdat, alt_counts_df = adsl)})[[3]]

    data.frame(nrows = nrow(tbl), ncols = ncol(tbl), build_time = bldtime)
}

    
